# CARRIER PRIORITY — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ─── Core ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ENABLE_CRON=true

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/carrier_priority
DB_SSL=false
DB_POOL_MAX=10

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ─── Stripe (subscription billing) ───────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Dwolla (ACH carrier payments — $250/mo flat) ────
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox

# ─── Plaid (bank verification) ───────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ─── ELD Integrations ─────────────────────────────────
SAMSARA_API_KEY=
MOTIVE_API_KEY=

# ─── Communications ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=

# ─── Mapping ───────────────────────────────────────────
MAPBOX_TOKEN=

# ─── E-Signature ───────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=

# ─── Load Board Feeds ──────────────────────────────────
DAT_API_KEY=
TRUCKSTOP_API_KEY=

# ─── FMCSA (free government API) ──────────────────────
FMCSA_API_KEY=

# ─── AWS S3 (document hub) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=carrier-priority-documents

# ─── Business Verification ─────────────────────────────
MIDDESK_API_KEY=

# ─── Push Notifications ────────────────────────────────
EXPO_ACCESS_TOKEN=
